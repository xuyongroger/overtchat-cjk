# Defaults for sandbox runs, loaded through MATPLOTLIBRC before user code runs.
# Code that sets its own rcParams still wins.

# A list of concrete families enables glyph fallback: Latin text keeps DejaVu
# Sans and CJK text falls through to Noto. A generic family such as sans-serif
# resolves to its first installed entry only, so it would leave CJK as boxes.
# (The upstream order is load-bearing: test_server asserts it verbatim.)
font.family: DejaVu Sans, Noto Sans CJK SC
# The fork also reorders the sans-serif list so a bare 'sans-serif' family
# resolves to Noto first (covers CJK, Latin and digits in one face; Droid is
# the TTF fallback for anything Noto lacks). Backend repeats this after pyplot
# import in case run code resets rcParams.
font.sans-serif: Noto Sans CJK SC, Droid Sans Fallback, DejaVu Sans, sans-serif

# The Unicode minus sign is missing from many fonts; use the ASCII hyphen.
axes.unicode_minus: False
