# Defaults for sandbox runs, loaded through MATPLOTLIBRC before user code runs.
# Code that sets its own rcParams still wins.

# A list of concrete families enables glyph fallback. A generic family such
# as sans-serif resolves to its first installed entry only, so it would leave
# CJK as boxes. Fork deviation from the upstream order (Noto leads, not trails):
# with DejaVu Sans first, per-glyph fallback silently draws unreadable tofu for
# pure-CJK strings on these fonts (measured 2026-11: tesseract reads nothing),
# yet emits no "Glyph ... missing" warning, so only an OCR check catches it.
# test_server's chart OCR test is the guard; the verbatim font.family assertion
# in test_renders_cjk_text_in_charts was adjusted to this order.
font.family: Noto Sans CJK SC, DejaVu Sans
# The sans-serif list is reordered the same way so a bare 'sans-serif' family
# resolves to Noto first (covers CJK, Latin and digits in one face; Droid is
# the TTF fallback for anything Noto lacks). Backend repeats this after pyplot
# import in case run code resets rcParams.
font.sans-serif: Noto Sans CJK SC, Droid Sans Fallback, DejaVu Sans, sans-serif

# The Unicode minus sign is missing from many fonts; use the ASCII hyphen.
axes.unicode_minus: False
